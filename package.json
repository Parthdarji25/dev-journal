{
  "name": "parth-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/copy-assets.ts && next dev",
    "build": "tsx scripts/copy-assets.ts && next build && tsx scripts/fix-segment-files.ts && tsx scripts/search-index.ts && tsx scripts/csp-hashes.ts",
    "build:artifacts": "tsx scripts/build-artifacts.ts",
    "start": "tsx scripts/serve.ts out 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "validate": "tsx scripts/validate-content.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-budgets": "tsx scripts/check-budgets.ts",
    "gen:shiki-css": "tsx scripts/gen-shiki-css.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "tsx scripts/lighthouse.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@octokit/rest": "22.0.1",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "gray-matter": "4.0.3",
    "lucide-react": "^1.55.0",
    "markmap-common": "0.18.9",
    "markmap-view": "0.18.12",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
