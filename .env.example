# Public URL of the main site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=parth.notes
# Repository that stores /content and receives admin commits.
NEXT_PUBLIC_GITHUB_OWNER=
NEXT_PUBLIC_GITHUB_REPO=
NEXT_PUBLIC_GITHUB_BRANCH=main
# Separate origin that serves uploaded HTML artifacts (second Vercel project).
NEXT_PUBLIC_ARTIFACTS_ORIGIN=
